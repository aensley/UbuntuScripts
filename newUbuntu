#!/usr/bin/env bash

# Performs common setup steps on a new Installation.

toRemove=''
toInstall=''
braveInstalled=''
flatpakInstalled=''
onlyofficeInstalled=''
rustInstalled=''
resiliosyncInstalled=''
jdkVersion=''

echoHugeHeader() {
  echo
  echo -e "====================  \033[32m\033[1m$1\033[m ==================== "
  echo
}

resolveJdkVersion() {
  if [ -n "${jdkVersion}" ]; then
    return
  fi

  for candidate in $(curl -fsS https://api.adoptium.net/v3/info/available_releases | jq -r '.available_lts_releases | reverse | .[]'); do
    if apt-cache show "openjdk-${candidate}-jdk" &>/dev/null; then
      jdkVersion="${candidate}"
      return
    fi
  done
}

resolveJdkVersion
if [ -z "${jdkVersion}" ]; then
  jdkVersion="25"
fi

# ---------- Remove ----------

removeApps() {
  echoHugeHeader "Removing Apps"
  sudo apt purge -y -f ${toRemove} && sudo apt -y -f --purge autoremove
}

removeSnaps() {
  sudo desnap
}

removeTracking() {
  toRemove="${toRemove} activity-log-manager apport zeitgeist-datahub"
}

# ---------- Install ----------

installApps() {
  echoHugeHeader "Installing Apps"
  sudo apt update && sudo apt -y -f install ${toInstall}
}

installBackdrop() {
  echoheader "Installing backdrop"
  wget -qO- https://ensl.ee/backdrop | bash -
}

installBrave() {
  braveInstalled='1'
}

installChromium() {
  toInstall="${toInstall} chromium-browser"
}

installDocker() {
  echoheader "Preparing to Install Docker"
  install-docker-prepare
  toInstall="${toInstall} docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin"
}

installEnpass() {
  echoheader "Preparing to Install Enpass"
  install-enpass-prepare
  toInstall="${toInstall} enpass"
}

installFirefox() {
  echoheader "Preparing to Install Firefox"
  install-firefox-prepare
  toInstall="${toInstall} firefox"
}

installFlatpak() {
  toInstall="${toInstall} flatpak"
  flatpakInstalled='1'
}

installGimp() {
  toInstall="${toInstall} gimp gimp-data-extras"
}

installJdk() {
  toInstall="${toInstall} openjdk-${jdkVersion}-jdk"
}

installJre() {
  toInstall="${toInstall} openjdk-${jdkVersion}-jre"
}

installKrita() {
  toInstall="${toInstall} krita"
}

installNodejs() {
  echoheader "Preparing to Install Node.js"
  install-node-prepare
  toInstall="${toInstall} nodejs"
}

installOnlyoffice() {
  echoheader "Preparing to Install OnlyOffice"
  install-onlyoffice-prepare
  toInstall="${toInstall} onlyoffice-desktopeditors"
  onlyofficeInstalled='1'
}

installOpenssh-server() {
  toInstall="${toInstall} openssh-server"
}

installRust() {
  rustInstalled='1'
}

installResiliosync() {
  resiliosyncInstalled='1'
}

installVlc() {
  toInstall="${toInstall} vlc"
}

installVscode() {
  echoheader "Preparing to Install VS Code"
  install-vscode-prepare
  toInstall="${toInstall} /tmp/vscode.deb"
}

# ---------- Main Thread ----------

echoHugeHeader "Checking Prereqs"
sudo apt update && sudo apt -y -f install git whiptail rsync figlet apt-transport-https curl ca-certificates
sudo pro config set apt_news=false

echoHugeHeader "Getting Scripts"
wget -qO- https://raw.githubusercontent.com/aensley/UbuntuScripts/main/sbin/updateScripts | bash -

## ----- Get Input -----

removeChoices=$(
  whiptail --title "Select Software to Remove" --checklist "Select Software to Remove" 10 40 5 \
    Tracking "Tracking" on \
    Snaps "Snap Packages" on \
    3>&1 1>&2 2>&3
)

installChoices=$(
  whiptail --title "Select Software to Install" --checklist "Select Software to Install" 23 50 17 \
    Backdrop "Backdrop" on \
    Brave "Brave Origin" on \
    Chromium "Chromium" off \
    Docker "Docker" off \
    Enpass "Enpass" on \
    Firefox "Firefox (Apt)" on \
    Flatpak "Flatpak" off \
    Gimp "GIMP" on \
    Jdk "JDK ${jdkVersion}" off \
    Jre "JRE ${jdkVersion}" off \
    Krita "Krita" on \
    Nodejs "Node.js LTS" off \
    Onlyoffice "OnlyOffice" on \
    Openssh-server "OpenSSH Server" on \
    Resiliosync "Resilio Sync" on \
    Rust "Rust" off \
    Vlc "VLC" on \
    Vscode "VS Code" on \
    3>&1 1>&2 2>&3
)

## ----- Remove -----

for removeJob in ${removeChoices}; do
  eval "remove${removeJob}"
done

removeApps

## ----- Upgrade -----

echoHugeHeader "Upgrading System"
sudo apt update && sudo apt -y -f -u full-upgrade && sudo apt autoremove --purge && sudo apt clean

## ----- Install -----

for installJob in ${installChoices}; do
  eval "install${installJob}"
done

installApps

if [ -n "${flatpakInstalled}" ]; then
  echoHugeHeader "Setting up Flathub Repo"
  flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
fi

if [ -n "${rustInstalled}" ]; then
  install-rust
fi

if [ -n "${onlyofficeInstalled}" ]; then
  install-onlyoffice-postinstall
fi

if [ -n "${resiliosyncInstalled}" ]; then
  sudo install-resilio-sync && \
    sudo install-resilio-sync-enable-auto-update
fi

if [ -n "${braveInstalled}" ]; then
  install-brave-origin
fi
